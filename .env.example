# Copy to .env and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=4000

# SQLite database file. Back this file up (or use Settings > Download a full backup).
DATABASE_PATH=./data/scrapbook.db

# Origins allowed to make state-changing requests (the Vite dev server by default).
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Days a sign-in lasts before the session expires (sliding window).
SESSION_TTL_DAYS=14

# Production behind a reverse proxy that terminates HTTPS:
#   TRUST_PROXY=true
# Cookies are marked Secure automatically when NODE_ENV=production.
# Set COOKIE_SECURE=false only for plain-HTTP testing on a trusted machine.

# Strongly recommended on any public deployment: first-run account creation then needs this code.
# SETUP_TOKEN=choose-a-long-random-string
